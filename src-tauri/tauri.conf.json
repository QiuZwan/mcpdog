{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCPDog",
  "version": "1.1.0",
  "identifier": "com.keysqiu.mcpdog",
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/node": "node",
      "resources/app": "app",
      "resources/VERSION": "VERSION"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
